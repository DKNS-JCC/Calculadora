rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla base — todo requiere auth
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // ── Báscula (ESP8266, sin auth) ─────────────────────────────
    // La báscula usa la API key pública embebida en el firmware.
    // Solo se abren los dos caminos estrictamente necesarios:

    // 1. Lectura del inventario de filamentos al arrancar (Compatible con GET y runQuery)
    match /empresas/{empresa} {
      // Permite listar/buscar si la consulta se limita a esta colección
      allow list: if true; 
      
      // Mantenemos tu acceso directo por documento por si acaso
      match /data/inventory {
        allow read: if true;
      }
    }

    // 2. Escritura de lecturas de peso
    match /filament_readings/{doc} {
      allow write: if true;
      allow read:  if request.auth != null;
    }
}
}